# =============================================================================
# Aevoy — Environment Variables
# =============================================================================
# Copy to .env.local (web) or .env (agent): cp .env.example .env.local
# Then fill in all required values via Railway/Vercel secrets manager.
# DO NOT PUT ACTUAL SECRETS IN THIS FILE.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=__SET_IN_VERCEL__
SUPABASE_SERVICE_ROLE_KEY=__SET_IN_RAILWAY__

# --- AI Services (at least one required) ---
# DO NOT put actual keys here. Set in Railway/Vercel secrets manager.
GROQ_API_KEY=__SET_IN_RAILWAY__                    # console.groq.com (fastest, primary)
DEEPSEEK_API_KEY=__SET_IN_RAILWAY__                # platform.deepseek.com
ANTHROPIC_API_KEY=__SET_IN_RAILWAY__               # console.anthropic.com (vision/complex)
GOOGLE_API_KEY=__SET_IN_RAILWAY__                  # Google AI Studio (Gemini Flash - free)
KIMI_API_KEY=__SET_IN_RAILWAY__                    # kimi.ai / Moonshot AI

# --- Browser Automation ---
# Option 1: VPS Multi-User Browser (Recommended for autonomy)
VPS_BROWSER_HOST=__SET_IN_RAILWAY__                # Your VPS IP or hostname (e.g., 1.2.3.4 or agent.aevoy.com)

# Option 2: Browserbase (Cloud fallback)
BROWSERBASE_API_KEY=__SET_IN_RAILWAY__             # browserbase.com dashboard
BROWSERBASE_PROJECT_ID=__SET_IN_RAILWAY__          # browserbase.com dashboard

# CAPTCHA Solving (CapSolver - AI-powered, 95%+ success, $0.0008-$0.003 per solve)
CAPSOLVER_API_KEY=__SET_IN_RAILWAY__               # capsolver.com - primary (fastest, cheapest, AI-powered)
TWOCAPTCHA_API_KEY=__SET_IN_RAILWAY__              # 2captcha.com - fallback (human solvers, slower but reliable)

# --- Voice/SMS (Twilio) ---
TWILIO_ACCOUNT_SID=__SET_IN_RAILWAY__              # twilio.com console
TWILIO_AUTH_TOKEN=__SET_IN_RAILWAY__               # twilio.com console
TWILIO_PHONE_NUMBER=__SET_IN_RAILWAY__             # Purchased Twilio number (E.164 format)
TWILIO_API_KEY_SID=__SET_IN_RAILWAY__              # Twilio API Key SID (SK...) — more secure than Auth Token
TWILIO_API_KEY_SECRET=__SET_IN_RAILWAY__           # Twilio API Key Secret

# --- Email (Resend) ---
RESEND_API_KEY=__SET_IN_RAILWAY__                  # resend.com dashboard

# --- Agent Server ---
AGENT_WEBHOOK_SECRET=__SET_IN_RAILWAY__            # Generate: openssl rand -hex 32
AGENT_PORT=3001
AGENT_URL=https://your-agent.up.railway.app
AGENT_WEBHOOK_BASE_URL=https://your-agent.up.railway.app

# --- IMAP Inbox (for email polling) ---
AGENT_INBOX_EMAIL=__SET_IN_RAILWAY__               # Gmail address for ImprovMX forwarding
AGENT_INBOX_PASSWORD=__SET_IN_RAILWAY__            # Gmail App Password (16 char)

# --- Google OAuth (for Gmail/Calendar/Drive API skills) ---
# NOTE: Requires 4-6 week approval process. Use Nylas below for instant access.
GOOGLE_OAUTH_CLIENT_ID=__SET_IN_VERCEL__           # console.cloud.google.com
GOOGLE_OAUTH_CLIENT_SECRET=__SET_IN_RAILWAY__      # console.cloud.google.com

# --- Nylas (RECOMMENDED: One-click email, no approval needed) ---
# Nylas provides hosted OAuth - works immediately with Gmail, Outlook, Yahoo
# Free tier: 5 connected accounts (perfect for beta launch)
NYLAS_CLIENT_ID=__SET_IN_VERCEL__                  # dashboard.nylas.com
NYLAS_API_KEY=__SET_IN_RAILWAY__                   # dashboard.nylas.com (nyk_v0_...)
NYLAS_CLIENT_SECRET=__SET_IN_RAILWAY__             # dashboard.nylas.com

# --- Microsoft OAuth (for Outlook/OneDrive API skills) ---
MICROSOFT_CLIENT_ID=__SET_IN_VERCEL__              # portal.azure.com
MICROSOFT_CLIENT_SECRET=__SET_IN_RAILWAY__         # portal.azure.com

# --- Security ---
ENCRYPTION_KEY=__SET_IN_RAILWAY__                  # 32 byte hex (generate: openssl rand -hex 32)

# --- CORS ---
ALLOWED_ORIGINS=https://aevoy.com,https://www.aevoy.com,http://localhost:3000

# --- Web App ---
NEXT_PUBLIC_APP_URL=https://www.aevoy.com

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=__SET_IN_RAILWAY__               # Stripe secret key (sk_test_... or sk_live_...)
STRIPE_WEBHOOK_SECRET=__SET_IN_RAILWAY__           # Stripe webhook signing secret

# --- Billing Configuration (ONE FLIP SWITCH) ---
#
# BILLING_ENABLED: Master switch for production billing
#   - false (default): Beta mode - all features free, no payment required, no budget enforcement
#   - true (production): Billing active - $10/month free tier enforced, payment required for overage
#
# What changes when BILLING_ENABLED=true:
#   1. Budget enforcement: Tasks blocked when user exceeds $10/month free tier
#   2. Payment collection: Stripe charges applied for overage (paid users only)
#   3. Budget alerts: 80% warning email sent, 100% blocking email sent
#   4. Invoice generation: Monthly invoices created for paid users
#   5. Payment modals: UI prompts for payment when over budget
#
# What stays the same when BILLING_ENABLED=false:
#   1. All features work unlimited (no payment required)
#   2. Usage tracked for analytics only (visible in dashboard)
#   3. No budget warnings or blocks
#   4. Beta users enjoy full access
#
# Production deployment: Set to 'true' in Railway/Vercel when ready to charge users
# Development/testing: Keep as 'false' to test without payment walls
#
BILLING_ENABLED=false

# SKIP_PAYMENT_CHECKS: Development-only override (ignores all quota checks)
# DO NOT USE IN PRODUCTION - use BILLING_ENABLED instead
SKIP_PAYMENT_CHECKS=false

# --- Local AI (optional - for privacy mode/offline) ---
OLLAMA_HOST=http://localhost:11434

# --- Development ---
NODE_ENV=development
AI_MOCK_MODE=false
TEST_MODE=false

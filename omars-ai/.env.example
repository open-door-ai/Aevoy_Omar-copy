# Omar's AI Assistant - Environment Variables
# Copy to .env and fill in actual values

# ============================================================================
# AI Models
# ============================================================================
OPENROUTER_API_KEY=sk-or-v1-...                    # Kimi K2.5 primary model
DEEPSEEK_API_KEY=sk-...                            # Fallback 1
GOOGLE_API_KEY=AIza...                             # Gemini fallback (free)
ANTHROPIC_API_KEY=sk-ant-...                       # Claude (for complex tasks)
KIMI_API_KEY=sk-...                                # Direct Kimi API (if needed)

# ============================================================================
# Communication (Twilio)
# ============================================================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+17789008951

# ============================================================================
# Email (IMAP + Resend)
# ============================================================================
IMAP_EMAIL=your-email@gmail.com
IMAP_PASSWORD=your-app-password                   # Gmail app password
RESEND_API_KEY=re_...

# ============================================================================
# Browser Automation
# ============================================================================
BROWSERBASE_API_KEY=bb_live_...                   # Cloud browser (optional)
BROWSERBASE_PROJECT_ID=...
TWOCAPTCHA_API_KEY=...                            # CAPTCHA solving (optional)

# ============================================================================
# Security
# ============================================================================
ENCRYPTION_KEY=generate_32_byte_hex_here          # openssl rand -hex 32
GATEWAY_WEBHOOK_SECRET=generate_secret_here       # openssl rand -hex 32

# ============================================================================
# Ports
# ============================================================================
GATEWAY_PORT=18789
CORE_PORT=3002
MISSION_CONTROL_PORT=3003
VISION_PORT=3004

# ============================================================================
# URLs
# ============================================================================
CORE_URL=http://localhost:3002
GATEWAY_URL=http://localhost:18789
MISSION_CONTROL_URL=http://localhost:3003

# ============================================================================
# Memory & Context
# ============================================================================
MEMORY_DIR=/home/omars-ai/assistant/memory
HEARTBEAT_MD=/home/omars-ai/assistant/memory/heartbeat.md
VAULT_DIR=/home/omars-ai/assistant/memory/encrypted

# ============================================================================
# Vision System
# ============================================================================
CAMERA_DEVICE=0                                    # USB webcam device ID
VISION_FPS=15
CONFIRMATION_FRAMES=5
QUIET_START=22                                     # 10 PM
QUIET_END=7                                        # 7 AM
BLUR_MODE=false

# ============================================================================
# Proactive Settings
# ============================================================================
HEARTBEAT_ACTIVE_INTERVAL=5                        # 5 minutes (desk presence)
HEARTBEAT_IDLE_INTERVAL=30                         # 30 minutes (away)
HEARTBEAT_SLEEP_INTERVAL=360                       # 6 hours (night)

# ============================================================================
# Misc
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info
TZ=America/Los_Angeles                             # Your timezone

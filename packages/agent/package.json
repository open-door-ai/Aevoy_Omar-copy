{
  "name": "agent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e-channels": "vitest run tests/e2e-all-channels.test.ts",
    "test:e2e-channels:verbose": "vitest run tests/e2e-all-channels.test.ts --reporter=verbose",
    "test:e2e-channels:watch": "vitest tests/e2e-all-channels.test.ts --watch",
    "test:flow": "tsx src/test.ts",
    "test:integration": "tsx src/test-utils/run-integration-tests.ts",
    "test:budget": "tsx tests/test-budget-enforcement.ts",
    "test:rate-limit": "tsx tests/security-rate-limiting.test.ts",
    "test:rate-limit-integration": "tsx tests/rate-limit-integration.test.ts",
    "test:rate-limit-load": "vitest run tests/rate-limiting-load.test.ts --reporter=verbose",
    "test:phone": "vitest run tests/phone-e2e.test.ts --reporter=verbose",
    "test:phone:real": "PHONE_TEST_REAL=true vitest run tests/phone-e2e.test.ts --reporter=verbose",
    "test:captcha-quick": "playwright test tests/captcha-quick-test.ts --reporter=list",
    "test:captcha-e2e": "playwright test tests/captcha-e2e.test.ts --reporter=list",
    "test:captcha-e2e:headed": "playwright test tests/captcha-e2e.test.ts --headed --reporter=list",
    "test:captcha-validation": "playwright test tests/captcha-validation.test.ts --reporter=list --workers=4",
    "test:captcha-stress": "playwright test tests/captcha-stress.test.ts --reporter=list --timeout=300000",
    "test:captcha-all": "playwright test tests/captcha-*.test.ts --reporter=html",
    "test:email-flow": "vitest run tests/e2e-email-flow.test.ts --reporter=verbose",
    "test:email-flow:watch": "vitest tests/e2e-email-flow.test.ts --watch",
    "test:send-email": "tsx tests/send-test-email.ts",
    "test:send-email:browser": "tsx tests/send-test-email.ts --browser",
    "test:flow-diagram": "tsx tests/generate-flow-diagram.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@browserbasehq/sdk": "^2.0.0",
    "@browserbasehq/stagehand": "^2.0.0",
    "@playwright/mcp": "^0.0.68",
    "@supabase/supabase-js": "^2.93.3",
    "@types/bcrypt": "^6.0.0",
    "@types/pdfkit": "^0.17.5",
    "@types/tar-stream": "^3.1.4",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "docx": "^9.5.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "fingerprint-generator": "^2.1.81",
    "fingerprint-injector": "^2.1.81",
    "ghost-cursor-patchright-core": "^1.3.42",
    "helmet": "^8.1.0",
    "imapflow": "^1.2.8",
    "libphonenumber-js": "^1.12.36",
    "nodemailer": "^8.0.0",
    "openai": "^4.70.0",
    "patchright": "^1.58.2",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "playwright": "^1.58.1",
    "postal-mime": "^2.7.3",
    "pptxgenjs": "^4.0.1",
    "resend": "^4.0.0",
    "stripe": "^20.3.1",
    "tar-stream": "^3.1.7",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.0.0",
    "ws": "^8.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pino": "^7.0.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}

# =============================================================================
# Aevoy — Environment Variables
# =============================================================================
# Copy to .env.local (web) or .env (agent): cp .env.example .env.local
# Then fill in all required values.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- AI Services (at least one required) ---
GROQ_API_KEY=xxx                    # console.groq.com (fastest, primary)
DEEPSEEK_API_KEY=xxx                # platform.deepseek.com
ANTHROPIC_API_KEY=xxx               # console.anthropic.com (vision/complex)
GOOGLE_API_KEY=xxx                  # Google AI Studio (Gemini Flash - free)
KIMI_API_KEY=xxx                    # kimi.ai / Moonshot AI

# --- Browser Automation ---
# Option 1: VPS Multi-User Browser (Recommended for autonomy)
VPS_BROWSER_HOST=xxx                # Your VPS IP or hostname (e.g., 1.2.3.4 or agent.aevoy.com)

# Option 2: Browserbase (Cloud fallback)
BROWSERBASE_API_KEY=xxx             # browserbase.com dashboard
BROWSERBASE_PROJECT_ID=xxx          # browserbase.com dashboard

# CAPTCHA Solving (CapSolver - AI-powered, 95%+ success, $0.0008-$0.003 per solve)
CAPSOLVER_API_KEY=xxx               # capsolver.com - primary (fastest, cheapest, AI-powered)
TWOCAPTCHA_API_KEY=xxx              # 2captcha.com - fallback (human solvers, slower but reliable)

# --- Voice/SMS (Twilio) ---
TWILIO_ACCOUNT_SID=xxx              # twilio.com console
TWILIO_AUTH_TOKEN=xxx               # twilio.com console
TWILIO_PHONE_NUMBER=xxx             # Purchased Twilio number (E.164 format)
TWILIO_API_KEY_SID=xxx              # Twilio API Key SID (SK...) — more secure than Auth Token
TWILIO_API_KEY_SECRET=xxx           # Twilio API Key Secret

# --- Email (Resend) ---
RESEND_API_KEY=xxx                  # resend.com dashboard

# --- Agent Server ---
AGENT_WEBHOOK_SECRET=your-random-secret-here
AGENT_PORT=3001
AGENT_URL=https://your-agent.up.railway.app
AGENT_WEBHOOK_BASE_URL=https://your-agent.up.railway.app

# --- IMAP Inbox (for email polling) ---
AGENT_INBOX_EMAIL=xxx               # Gmail address for ImprovMX forwarding
AGENT_INBOX_PASSWORD=xxx            # Gmail App Password (16 char)

# --- Google OAuth (for Gmail/Calendar/Drive API skills) ---
# NOTE: Requires 4-6 week approval process. Use Nylas below for instant access.
GOOGLE_OAUTH_CLIENT_ID=xxx          # console.cloud.google.com
GOOGLE_OAUTH_CLIENT_SECRET=xxx      # console.cloud.google.com

# --- Nylas (RECOMMENDED: One-click email, no approval needed) ---
# Nylas provides hosted OAuth - works immediately with Gmail, Outlook, Yahoo
# Free tier: 5 connected accounts (perfect for beta launch)
NYLAS_CLIENT_ID=xxx                 # dashboard.nylas.com
NYLAS_API_KEY=xxx                   # dashboard.nylas.com (nyk_v0_...)
NYLAS_CLIENT_SECRET=xxx             # dashboard.nylas.com

# --- Microsoft OAuth (for Outlook/OneDrive API skills) ---
MICROSOFT_CLIENT_ID=xxx             # portal.azure.com
MICROSOFT_CLIENT_SECRET=xxx         # portal.azure.com

# --- Security ---
ENCRYPTION_KEY=xxx                  # 32 byte hex (generate: openssl rand -hex 32)

# --- CORS ---
ALLOWED_ORIGINS=https://aevoy.com,https://www.aevoy.com,http://localhost:3000

# --- Web App ---
NEXT_PUBLIC_APP_URL=https://www.aevoy.com

# --- Stripe (billing) ---
STRIPE_WEBHOOK_SECRET=xxx           # Stripe webhook signing secret

# --- Local AI (optional - for privacy mode/offline) ---
OLLAMA_HOST=http://localhost:11434

# --- Development ---
NODE_ENV=development
AI_MOCK_MODE=false
TEST_MODE=false
